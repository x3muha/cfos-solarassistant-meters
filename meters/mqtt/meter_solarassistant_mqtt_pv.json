    "resolution": 1.0
  },
  "*pvCurrent1A": {
    "address": "solar_assistant/inverter_1/pv_current_1/state",
    "type": "float",
    "regex": "(-?\\d+(?:\\.\\d+)?)",
    "resolution": 1.0
  },
  "*pvVoltage2V": {
    "address": "solar_assistant/inverter_1/pv_voltage_2/state",
    "type": "float",
    "regex": "(-?\\d+(?:\\.\\d+)?)",
    "resolution": 1.0
  },
  "*pvCurrent2A": {
    "address": "solar_assistant/inverter_1/pv_current_2/state",
    "type": "float",
    "regex": "(-?\\d+(?:\\.\\d+)?)",
    "resolution": 1.0
  },
  "*pvVoltage3V": {
    "address": "solar_assistant/inverter_1/pv_voltage_3/state",
