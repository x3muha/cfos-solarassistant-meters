{
  "rtype": 2,
  "mtype": 2,
  "name": "SolarAssistant MQTT PV",
  "manufacturer": "SolarAssistant",
  "dev_type": "solarassistant_mqtt_pv",
  "upd_delay": 2000,
  "delay_accumulated": true,
  "type_designation": {
    "fixed": "SolarAssistant MQTT PV"
  },
  "version": {
    "fixed": "1.0"
  },
  "serial": {
    "fixed": "sa-mqtt-pv"
  },
